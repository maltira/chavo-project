# Единственная точка входа: /api/ и /ws проксируются в Gateway, остальное — статика фронтенда
# Шаблон: при старте контейнера ${GATEWAY_PORT} подставляется envsubst (переменные nginx вида $remote_addr не трогаются)

upstream gateway {
    server api-gateway:${GATEWAY_PORT};
    keepalive 32;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# X-Request-ID клиента сохраняется, если он корректный; иначе — свой.
map $http_x_request_id $chavo_request_id {
    "~^[A-Za-z0-9._-]{1,128}$" $http_x_request_id;
    default                    $request_id;
}

# Лимиты по IP. Лимиты по пользователю считает Gateway.
limit_req_zone  $binary_remote_addr zone=auth_ip:10m rate=10r/m;
limit_req_zone  $binary_remote_addr zone=api_ip:10m  rate=20r/s;
limit_req_zone  $binary_remote_addr zone=ws_ip:10m   rate=20r/m;
limit_conn_zone $binary_remote_addr zone=ws_conn:10m;
limit_req_status    429;
limit_conn_status   429;
limit_req_log_level warn;
limit_conn_log_level warn;

server {
    listen 80;
    server_name _;
    server_tokens off;

    # Совпадает с лимитом тела в Gateway.
    client_max_body_size 1m;

    error_page 413 = @too_large;
    error_page 429 = @rate_limited;
    error_page 502 503 504 = @unavailable;

    # Вход, регистрация, OTP, refresh, сброс пароля: подбор пароля и спам писем.
    location /api/auth/ {
        limit_req zone=auth_ip burst=10 nodelay;
        limit_req zone=api_ip burst=40 nodelay;
        include /etc/nginx/chavo/proxy_params.conf;
        proxy_pass http://gateway;
    }

    location /api/ {
        limit_req zone=api_ip burst=40 nodelay;
        include /etc/nginx/chavo/proxy_params.conf;
        proxy_pass http://gateway;
    }

    location = /ws {
        limit_req  zone=ws_ip burst=10 nodelay;
        limit_conn ws_conn 10;
        include /etc/nginx/chavo/proxy_params.conf;
        # Больше интервала ping Gateway (30 с): живое соединение не рвётся по таймауту прокси.
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;
        proxy_pass http://gateway;
    }

    # Healthcheck контейнера; наружу ничего не раскрывает.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    location @too_large {
        default_type "application/json; charset=utf-8";
        return 413 '{"error":"Слишком большой запрос","reason":"PAYLOAD_TOO_LARGE"}';
    }

    location @rate_limited {
        default_type "application/json; charset=utf-8";
        add_header Retry-After 60 always;
        return 429 '{"error":"Слишком много запросов, попробуйте позже","reason":"RATE_LIMITED"}';
    }

    location @unavailable {
        default_type "application/json; charset=utf-8";
        return 503 '{"error":"Сервис временно недоступен","reason":"SERVICE_UNAVAILABLE"}';
    }
}
