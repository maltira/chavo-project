JWT_SECRET=
ACCESS_TOKEN_DURATION=10m
REFRESH_TOKEN_DURATION=43200m
VERIFICATION_TTL=15m

# адрес фронтенда: ссылки в письмах и единственный разрешённый Origin для WebSocket
FRONTEND_URL=http://localhost:3000

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

AUTH_DB_NAME=
USER_DB_NAME=
CONVERSATION_DB_NAME=

# Локально — Mailpit из compose: письма не уходят наружу, смотреть их в UI http://localhost:${MAILPIT_UI_PORT}.
# SMTP_USER — адрес отправителя (From). Настоящий SMTP: SMTP_HOST=smtp.example.com, SMTP_PORT=465, логин и пароль.
# make e2e запускается только с Mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=noreply@chavo.local
SMTP_PASS=
MAILPIT_UI_PORT=8025

REDIS_URL=redis://chavo-redis:6379/0

KAFKA_UI_PORT=8090

ENV=development
AUTH_PORT=8001
USER_PORT=8002
CONVERSATION_PORT=8003
GATEWAY_PORT=8000

# дедлайн вызова сервиса из Gateway
GRPC_TIMEOUT=5s

# IP/CIDR через запятую, чьим X-Forwarded-For/Proto верит Gateway; в compose это фиксированный адрес nginx.
# Пусто — не доверять никому: Gateway увидит IP nginx вместо клиента и не поставит Secure у cookie за HTTPS
TRUSTED_PROXIES=172.28.10.10

# единственный опубликованный порт (nginx)
NGINX_PORT=8080

# лимиты Gateway по пользователю: <число>/<окно>
RATE_LIMIT_API=300/1m
RATE_LIMIT_MESSAGES=30/10s
RATE_LIMIT_WS=20/1s

# base64 от 32 случайных байт: openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=
